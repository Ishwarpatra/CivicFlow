# ─── Required ────────────────────────────────────────────────────────────────
# Gemini AI API key — optional when NVIDIA_NIM_API_KEY is configured
GEMINI_API_KEY=

# NVIDIA NIM hosted chat API — configure this encrypted secret in Render, never in Git.
# Choose a supported model ID from https://build.nvidia.com/; this default is used if omitted.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# Secure random string for signing session cookies (change before deploying)
SESSION_SECRET=

# ─── Google Services (strongly recommended) ───────────────────────────────────
# Google Maps JavaScript API key — enables real map embeds in Find My Booth
# Enable "Maps JavaScript API" and "Maps Embed API" at console.cloud.google.com
GOOGLE_MAPS_API_KEY=

# Google Civic Information API key — returns real representative data
# Enable "Google Civic Information API" at console.cloud.google.com
GOOGLE_CIVIC_API_KEY=

# ─── Firebase Firestore (persistent vote storage) ─────────────────────────────
# Create a service account at console.firebase.google.com → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── CORS & Runtime ───────────────────────────────────────────────────────────
# Comma-separated allowed origins in production (e.g. https://civicflow.in)
ALLOWED_ORIGINS=http://localhost:8080
# Use development locally. Docker Compose overrides this to production.
NODE_ENV=development
PORT=8080
# pino log level: fatal, error, warn, info, debug, or trace.
LOG_LEVEL=info

# ─── Operations ────────────────────────────────────────────────────────────────
# Comma-separated admin allowlist; do not derive admin role from registration input.
ADMIN_EMAILS=
# Optional polling lookup election identifier.
GOOGLE_CIVIC_ELECTION_ID=
# Use an absolute path backed by persistent storage in production.
# Docker Compose defaults to /var/lib/civicflow/civicflow.db.
DB_PATH=./data/civicflow.db
# Absolute persistent directory for sessions in production.
# Docker Compose defaults to /var/lib/civicflow.
SESSION_DIR=./data
# Optional filename within SESSION_DIR.
SESSION_DB=sessions.db
